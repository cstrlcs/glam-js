

<%
	const N = it.length;
	const type = `${it.name}${N}`;
	const mat = `Mat${N}`;
	const vec = `Vec${N}`;
	const bigMat = `Mat${N + 1}`;
	const bigVec = `Vec${N + 1}`;
	const field = `matrix${N}`;
	const axes = ["xAxis", "yAxis", "zAxis", "wAxis"];
	const matAxes = axes.slice(0, N);
	const cols = axes.slice(0, N + 1);
	const components = ["x", "y", "z"].slice(0, N);
	const bigComponents = ["x", "y", "z", "w"].slice(0, N + 1);
	const indices = [...Array(N).keys()];
	const colIndices = [...Array(N + 1).keys()];
	const count = N * (N + 1);
	const tuple = (n) => `[${Array(n).fill("number").join(", ")}]`;
	const colsArray = tuple(count);
	const colsArray2d = `[${Array(N + 1).fill(tuple(N)).join(", ")}]`;
	const col = (target, c) => (c === N ? `${target}.translation` : `${target}.${field}.${axes[c]}`);
	const el = (target, c, r) => `${col(target, c)}.${components[r]}`;
	const local = (c, r) => `${c === N ? "translation" : axes[c]}.${components[r]}`;
	const locals = `const { ${matAxes.join(", ")} } = this.${field};
		const { translation } = this;`;
	const newVec = (values) => `new ${vec}(${values.join(", ")})`;
	const newMat = (fn) => `new ${mat}(${indices.map((c) => newVec(indices.map((r) => fn(c, r)))).join(", ")})`;
	const newAffine = (fn) => `new ${type}(${newMat(fn)}, ${newVec(indices.map((r) => fn(N, r)))})`;
	const params = (fn) => colIndices.flatMap((c) => indices.map((r) => fn(c, r)));
	const sum = (fn) => indices.map(fn).join(" + ");
	const mulAffine = (c, r) => `${sum((k) => `${local(k, r)} * ${el("rhs", c, k)}`)}${c === N ? ` + ${local(N, r)}` : ""}`;
	const mulBigMat = (c, r) => (r === N
		? `rhs.${axes[c]}.${bigComponents[N]}`
		: `${sum((k) => `${local(k, r)} * rhs.${axes[c]}.${bigComponents[k]}`)} + ${local(N, r)} * rhs.${axes[c]}.${bigComponents[N]}`);
	const transformPoint = `${locals}

		return ${newVec(indices.map((r) => `${sum((k) => `${local(k, r)} * rhs.${components[k]}`)} + ${local(N, r)}`))};`;
	const transformVector = `const { ${matAxes.join(", ")} } = this.${field};

		return ${newVec(indices.map((r) => sum((k) => `${local(k, r)} * rhs.${components[k]}`)))};`;
	const zero = newVec(indices.map(() => "0"));
	const signum = (value) => `Math.sign(${value} + 1 / ${value})`;
	const block = (statements, indent) => statements.map((text, i) => {
		const long = (value) => indent + value.length > 100;
		const separator = i === 0 ? "" : long(text) || long(statements[i - 1]) ? "\n\n" : "\n";

		return `${separator}${"\t".repeat(indent / 2)}${text}`;
	}).join("");
%>
<% if (N === 2) { %>
import { Mat2 } from "./Mat2.js";
import { Mat3 } from "./Mat3.js";
import { Vec2 } from "./Vec2.js";
import { Vec3 } from "./Vec3.js";
<% } else { %>
import { Mat3 } from "./Mat3.js";
import { Mat4 } from "./Mat4.js";
import { Quat } from "./Quat.js";
import { Vec3 } from "./Vec3.js";
import { Vec4 } from "./Vec4.js";
<% } %>

/** A <%= N %>D affine transform, which can represent translation, rotation, scaling and shear. */
export class <%= type %> {
	declare <%= field %>: <%= mat %>;
	declare translation: <%= vec %>;

	constructor(<%= field %>: <%= mat %>, translation: <%= vec %>) {
		this.<%= field %> = <%= field %>;
		this.translation = translation;
	}

	/**
	 * The degenerate zero transform.
	 *
	 * This transforms any finite vector and point to zero.
	 * The zero transform is non-invertible.
	 */
	static get ZERO() {
		return <%= newAffine(() => "0") %>;
	}

	/**
	 * The identity transform.
	 *
	 * Multiplying a vector with this returns the same vector.
	 */
	static get IDENTITY() {
		return <%= newAffine((c, r) => (c === r ? "1" : "0")) %>;
	}

	/** All NAN:s. */
	static get NAN() {
		return <%= newAffine(() => "Number.NaN") %>;
	}

	/** Creates an affine transform from three column vectors. */
	static fromCols(<%= cols.map((value) => `${value}: ${vec}`).join(", ") %>): <%= type %> {
		return new <%= type %>(new <%= mat %>(<%= matAxes.join(", ") %>), <%= cols[N] %>);
	}

	/** Creates an affine transform from a `[number; <%= count %>]` array stored in column major order. */
	static fromColsArray(m: <%= colsArray %>): <%= type %> {
		return <%= newAffine((c, r) => `m[${c * N + r}]`) %>;
	}

	/** Creates a `[number; <%= count %>]` array storing data in column major order. */
	toColsArray(): <%= colsArray %> {
		return [<%= params((c, r) => el("this", c, r)).join(", ") %>];
	}

	/**
	 * Creates an affine transform from a `[[number; <%= N %>]; <%= N + 1 %>]`
	 * <%= N %>D array stored in column major order.
	 * If your data is in row major order you will need to `transpose` the returned
	 * matrix.
	 */
	static fromColsArray2d(m: <%= colsArray2d %>): <%= type %> {
		return <%= newAffine((c, r) => `m[${c}][${r}]`) %>;
	}

	/**
	 * Creates a `[[number; <%= N %>]; <%= N + 1 %>]` <%= N %>D array storing data in
	 * column major order.
	 * If you require data in row major order `transpose` the matrix first.
	 */
	toColsArray2d(): <%= colsArray2d %> {
		return [<%= colIndices.map((c) => `[${indices.map((r) => el("this", c, r)).join(", ")}]`).join(", ") %>];
	}

	/**
	 * Creates an affine transform from the first <%= count %> values in `slice`.
	 *
	 * Throws a `RangeError` if `slice` is less than <%= count %> elements long.
	 */
	static fromColsSlice(slice: ArrayLike<number>): <%= type %> {
		return <%= newAffine((c, r) => `${type}.#sliceElement(slice, ${c * N + r})`) %>;
	}

	/**
	 * Writes the columns of `this` to the first <%= count %> elements in `slice`.
	 *
	 * Throws a `RangeError` if `slice` is less than <%= count %> elements long.
	 */
	writeColsToSlice(slice: { [index: number]: number; readonly length: number }): void {
		if (slice.length < <%= count %>) {
			throw new RangeError("index out of bounds");
		}

<% for (const c of colIndices) { %>
<% for (const r of indices) { %>
		slice[<%= c * N + r %>] = <%= el("this", c, r) %>;
<% } %>
<% } %>
	}

	/**
	 * Creates an affine transform that changes scale.
	 * Note that if any scale is zero the transform will be non-invertible.
	 */
	static fromScale(scale: <%= vec %>): <%= type %> {
		return <%= newAffine((c, r) => (c === r ? `scale.${components[c]}` : "0")) %>;
	}

<% if (N === 2) { %>
	/** Creates an affine transform from the given rotation `angle`. */
	static fromAngle(angle: number): Affine2 {
		return new Affine2(Mat2.fromAngle(angle), <%= zero %>);
	}

	/** Creates an affine transformation from the given 2D `translation`. */
	static fromTranslation(translation: Vec2): Affine2 {
		return <%= newAffine((c, r) => (c === N ? `translation.${components[r]}` : c === r ? "1" : "0")) %>;
	}

	/** Creates an affine transform from a 2x2 matrix (expressing scale, shear and rotation) */
	static fromMat2(matrix2: Mat2): Affine2 {
		return new Affine2(matrix2.clone(), <%= zero %>);
	}

	/**
	 * Creates an affine transform from a 2x2 matrix (expressing scale, shear and rotation) and a
	 * translation vector.
	 *
	 * Equivalent to
	 * `Affine2.fromTranslation(translation).mul(Affine2.fromMat2(mat2))`
	 */
	static fromMat2Translation(matrix2: Mat2, translation: Vec2): Affine2 {
		return new Affine2(matrix2.clone(), translation.clone());
	}

	/**
	 * Creates an affine transform from the given 2D `scale`, rotation `angle` (in radians) and
	 * `translation`.
	 *
	 * Equivalent to `Affine2.fromTranslation(translation).mul(Affine2.fromAngle(angle)).mul(Affine2.fromScale(scale))`
	 */
	static fromScaleAngleTranslation(scale: Vec2, angle: number, translation: Vec2): Affine2 {
		const sin = Math.sin(angle);
		const cos = Math.cos(angle);

		return new Affine2(
			new Mat2(new Vec2(cos * scale.x, sin * scale.x), new Vec2(-sin * scale.y, cos * scale.y)),
			translation.clone(),
		);
	}

	/**
	 * Creates an affine transform from the given 2D rotation `angle` (in radians) and
	 * `translation`.
	 *
	 * Equivalent to `Affine2.fromTranslation(translation).mul(Affine2.fromAngle(angle))`
	 */
	static fromAngleTranslation(angle: number, translation: Vec2): Affine2 {
		return new Affine2(Mat2.fromAngle(angle), translation.clone());
	}

	/** The given `Mat3` must be an affine transform, */
	static fromMat3(m: Mat3): Affine2 {
		return <%= newAffine((c, r) => `m.${axes[c]}.${components[r]}`) %>;
	}

	/**
	 * Extracts `scale`, `angle` and `translation` from `this`.
	 *
	 * The transform is expected to be non-degenerate and without shearing, or the output
	 * will be invalid.
	 */
	toScaleAngleTranslation(): [Vec2, number, Vec2] {
		const { xAxis, yAxis } = this.matrix2;
		const det = this.matrix2.determinant();
		const scale = new Vec2(xAxis.length() * <%= signum("det") %>, yAxis.length());

		return [scale, Math.atan2(-yAxis.x, yAxis.y), this.translation.clone()];
	}

	/** Transforms the given 2D point, applying shear, scale, rotation and translation. */
	transformPoint2(rhs: Vec2): Vec2 {
		<%= transformPoint %>
	}

	/**
	 * Transforms the given 2D vector, applying shear, scale and rotation (but NOT
	 * translation).
	 *
	 * To also apply translation, use `transformPoint2()` instead.
	 */
	transformVector2(rhs: Vec2): Vec2 {
		<%= transformVector %>
	}

<% } else { %>
	/** Creates an affine transform from the given `rotation` quaternion. */
	static fromQuat(rotation: Quat): Affine3 {
		return new Affine3(Mat3.fromQuat(rotation), <%= zero %>);
	}

	/**
	 * Creates an affine transform containing a 3D rotation around a normalized
	 * rotation `axis` of `angle` (in radians).
	 */
	static fromAxisAngle(axis: Vec3, angle: number): Affine3 {
		return new Affine3(Mat3.fromAxisAngle(axis, angle), <%= zero %>);
	}

<% for (const name of ["x", "y", "z"]) { %>
	/**
	 * Creates an affine transform containing a 3D rotation around the <%= name %> axis of
	 * `angle` (in radians).
	 */
	static fromRotation<%= name.toUpperCase() %>(angle: number): Affine3 {
		return new Affine3(Mat3.fromRotation<%= name.toUpperCase() %>(angle), <%= zero %>);
	}

<% } %>
	/** Creates an affine transformation from the given 3D `translation`. */
	static fromTranslation(translation: Vec3): Affine3 {
		return <%= newAffine((c, r) => (c === N ? `translation.${components[r]}` : c === r ? "1" : "0")) %>;
	}

	/**
	 * Creates an affine transform from a 3x3 matrix (expressing scale, shear and
	 * rotation)
	 */
	static fromMat3(mat3: Mat3): Affine3 {
		return new Affine3(mat3.clone(), <%= zero %>);
	}

	/**
	 * Creates an affine transform from a 3x3 matrix (expressing scale, shear and rotation)
	 * and a translation vector.
	 *
	 * Equivalent to `Affine3.fromTranslation(translation).mul(Affine3.fromMat3(mat3))`
	 */
	static fromMat3Translation(mat3: Mat3, translation: Vec3): Affine3 {
		return new Affine3(mat3.clone(), translation.clone());
	}

	/**
	 * Creates an affine transform from the given 3D `scale`, `rotation` and
	 * `translation`.
	 *
	 * Equivalent to `Affine3.fromTranslation(translation).mul(Affine3.fromQuat(rotation)).mul(Affine3.fromScale(scale))`
	 */
	static fromScaleRotationTranslation(scale: Vec3, rotation: Quat, translation: Vec3): Affine3 {
		const { x, y, z, w } = rotation;
		const x2 = x + x;
		const y2 = y + y;
		const z2 = z + z;
		const xx = x * x2;
		const xy = x * y2;
		const xz = x * z2;
		const yy = y * y2;
		const yz = y * z2;
		const zz = z * z2;
		const wx = w * x2;
		const wy = w * y2;
		const wz = w * z2;

		return new Affine3(
			new Mat3(
				new Vec3((1 - (yy + zz)) * scale.x, (xy + wz) * scale.x, (xz - wy) * scale.x),
				new Vec3((xy - wz) * scale.y, (1 - (xx + zz)) * scale.y, (yz + wx) * scale.y),
				new Vec3((xz + wy) * scale.z, (yz - wx) * scale.z, (1 - (xx + yy)) * scale.z),
			),
			translation.clone(),
		);
	}

	/**
	 * Creates an affine transform from the given 3D `rotation` and `translation`.
	 *
	 * Equivalent to `Affine3.fromTranslation(translation).mul(Affine3.fromQuat(rotation))`
	 */
	static fromRotationTranslation(rotation: Quat, translation: Vec3): Affine3 {
		return new Affine3(Mat3.fromQuat(rotation), translation.clone());
	}

	/**
	 * The given `Mat4` must be an affine transform,
	 * i.e. contain no perspective transform.
	 */
	static fromMat4(m: Mat4): Affine3 {
		return <%= newAffine((c, r) => `m.${axes[c]}.${components[r]}`) %>;
	}

	/**
	 * Extracts `scale`, `rotation` and `translation` from `this`.
	 *
	 * The transform is expected to be non-degenerate and without shearing, or the output
	 * will be invalid.
	 */
	toScaleRotationTranslation(): [Vec3, Quat, Vec3] {
		const { xAxis, yAxis, zAxis } = this.matrix3;
		const det = this.matrix3.determinant();

		const scale = new Vec3(xAxis.length() * <%= signum("det") %>, yAxis.length(), zAxis.length());

		const invX = 1 / scale.x;
		const invY = 1 / scale.y;
		const invZ = 1 / scale.z;

		const rotation = Quat.fromRotationAxes(
			new Vec3(xAxis.x * invX, xAxis.y * invX, xAxis.z * invX),
			new Vec3(yAxis.x * invY, yAxis.y * invY, yAxis.z * invY),
			new Vec3(zAxis.x * invZ, zAxis.y * invZ, zAxis.z * invZ),
		);

		return [scale, rotation, this.translation.clone()];
	}

	/** Transforms the given 3D points, applying shear, scale, rotation and translation. */
	transformPoint3(rhs: Vec3): Vec3 {
		<%= transformPoint %>
	}

	/**
	 * Transforms the given 3D vector, applying shear, scale and rotation (but NOT
	 * translation).
	 *
	 * To also apply translation, use `transformPoint3()` instead.
	 */
	transformVector3(rhs: Vec3): Vec3 {
		<%= transformVector %>
	}

<% } %>
	/**
	 * Returns `true` if, and only if, all elements are finite.
	 *
	 * If any element is either `NaN`, positive or negative infinity, this will return
	 * `false`.
	 */
	isFinite(): boolean {
		return <%= params((c, r) => `Number.isFinite(${el("this", c, r)})`).join(" && ") %>;
	}

	/** Returns `true` if any elements are `NaN`. */
	isNan(): boolean {
		return <%= params((c, r) => `Number.isNaN(${el("this", c, r)})`).join(" || ") %>;
	}

	/**
	 * Returns true if the absolute difference of all elements between `this` and `rhs`
	 * is less than or equal to `maxAbsDiff`.
	 *
	 * This can be used to compare if two 3x4 matrices contain similar elements. It works
	 * best when comparing with a known value. The `maxAbsDiff` that should be used used
	 * depends on the values being compared against.
	 *
	 * For more see
	 * [comparing floating point numbers](https://randomascii.wordpress.com/2012/02/25/comparing-floating-point-numbers-2012-edition/).
	 */
	absDiffEq(rhs: <%= type %>, maxAbsDiff: number): boolean {
		return <%= params((c, r) => `Math.abs(${el("this", c, r)} - ${el("rhs", c, r)}) <= maxAbsDiff`).join(" && ") %>;
	}

	/**
	 * Return the inverse of this transform.
	 *
	 * Note that if the transform is not invertible the result will be invalid.
	 */
	inverse(): <%= type %> {
		const <%= field %> = this.<%= field %>.inverse();
		const { <%= matAxes.join(", ") %> } = <%= field %>;
		const { translation } = this;

		return new <%= type %>(<%= field %>, <%= newVec(indices.map((r) => `-(${sum((k) => `${axes[k]}.${components[r]} * ${local(N, k)}`)})`)) %>);
	}

<% for (const [c, name] of cols.entries()) { %>
	get <%= name %>(): <%= vec %> {
		return <%= col("this", c) %>;
	}

	set <%= name %>(value: <%= vec %>) {
		<%= col("this", c) %> = value;
	}

<% } %>
	clone(): <%= type %> {
		return <%= newAffine((c, r) => el("this", c, r)) %>;
	}

	mul(rhs: <%= bigMat %>): <%= bigMat %>;
	mul(rhs: <%= type %>): <%= type %>;
	mul(rhs: <%= type %> | <%= bigMat %>): <%= type %> | <%= bigMat %> {
		<%= locals %>

		if (rhs instanceof <%= bigMat %>) {
			return new <%= bigMat %>(
<% for (const c of colIndices) { %>
				new <%= bigVec %>(<%= colIndices.map((r) => mulBigMat(c, r)).join(", ") %>),
<% } %>
			);
		}

		return <%= newAffine(mulAffine) %>;
	}

	mulAssign(rhs: <%= type %>): this {
<%= block([`const { ${matAxes.join(", ")} } = this.${field};`, "const { translation } = this;", ...colIndices.flatMap((c) => indices.map((r) => `const m${c}${r} = ${mulAffine(c, r)};`))], 4) %>

<% for (const c of colIndices) { %>
<% for (const r of indices) { %>
		<%= local(c, r) %> = m<%= c %><%= r %>;
<% } %>
<% } %>

		return this;
	}

	eq(rhs: <%= type %>): boolean {
		return <%= params((c, r) => `${el("this", c, r)} === ${el("rhs", c, r)}`).join(" && ") %>;
	}

	ne(rhs: <%= type %>): boolean {
		return <%= params((c, r) => `${el("this", c, r)} !== ${el("rhs", c, r)}`).join(" || ") %>;
	}

	toString(): string {
		return `<%= `[${colIndices.map((c) => `[${indices.map((r) => "${" + el("this", c, r) + "}").join(", ")}]`).join(", ")}]` %>`;
	}

	static #sliceElement(slice: ArrayLike<number>, index: number): number {
		const value = slice[index];

		if (value === undefined) {
			throw new RangeError("index out of bounds");
		}

		return value;
	}
}
